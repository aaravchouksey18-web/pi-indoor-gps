// pi-indoor-sniffer configuration.
// Copy this file to config.h and fill in your values. config.h is gitignored —
// it holds real credentials, it must never be committed.
#ifndef CONFIG_H
#define CONFIG_H

// BOARD_ID must stay <= 16 chars: pi/messages.py drops longer board ids
// silently, and the sketch below static_asserts the cap at compile time.
#define BOARD_ID     "a"            // distinct per node: "a", "b", ...
#define SNIFF_CHANNEL 6             // channel your network associates on

#define WIFI_SSID   "YOUR_WIFI_SSID"
#define WIFI_PASS   "YOUR_WIFI_PASS"

#define MQTT_HOST   "YOUR_BROKER_HOST_OR_IP"
#define MQTT_PORT   1883

// Optional broker credentials (empty = anonymous). When MQTT_USER is
// non-empty the sketch sends them in the MQTT CONNECT packet via the 8-arg
// mqtt.connect() overload (PubSubClient has no setCredentials()); the Pi
// scripts read the same names from the MQTT_USER / MQTT_PASS environment
// variables.
#define MQTT_USER   ""
#define MQTT_PASS   ""

#endif